{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": [
    "src/components/OptimizedArtworkAnalysisScreen.tsx",
    "src/components/SimplifiedArtworkAnalysisScreen.tsx",
    "src/services/enhancedEducationalService.ts",
    "src/services/optimizedWorkflowService.ts",
    "src/services/unifiedWorkflowService.ts",
    "src/services/workflowMonitor.ts",
    "src/services/workflowTester.ts",
    "src/services/comprehensiveEducationalService.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
